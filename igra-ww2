let hillAnim=null;
function animateHill(pct){
  const rect=document.getElementById("hillRect"),label=document.getElementById("hillPct");
  if(!rect||!label)return;
  const t0=performance.now(),from=0,to=Math.max(0,Math.min(100,pct));
  if(hillAnim)cancelAnimationFrame(hillAnim);
  (function step(t){
    const k=Math.min(1,(t-t0)/900),e=1-Math.pow(1-k,3),v=from+(to-from)*e;
    rect.setAttribute("width",v/100*480);
    label.textContent=Math.round(v)+"% зазеленело";
    if(k<1)hillAnim=requestAnimationFrame(step);
  })(t0);
}
function countUp(el,target,dur){
  if(!el)return;
  const t0=performance.now();
  (function step(t){
    const k=Math.min(1,(t-t0)/dur);
    el.textContent=Math.round(target*(1-Math.pow(1-k,3)));
    if(k<1)requestAnimationFrame(step);
  })(t0);
}

screenWelcome();
</script>
